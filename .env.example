# Copy to .env and fill in.
#
# LOCAL / SETUP defaults: everything works blank -> SQLite at data/results.db,
# bot disabled if no token, cache in "setup" mode (re-ingests show instantly).
#
# PRODUCTION (docker-compose.prod.yml on the VPS): set the values marked [PROD].

# --- Database ---------------------------------------------------------------
# Blank -> zero-config SQLite (great for local + first data load).
# [PROD] Point at the bundled Postgres service (host = "postgres" on the compose
# network). Must match POSTGRES_* below.
# DATABASE_URL=postgresql+psycopg://results:CHANGE_ME@postgres:5432/results

# Postgres credentials used by the postgres + backup services. [PROD] change password.
POSTGRES_USER=results
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=results

# Where SQLite + temp data live. Defaults to ./data (container: /app/data).
DATA_DIR=

# --- Caching / CDN ----------------------------------------------------------
# setup -> "no-cache" (revalidate; re-ingests appear immediately). Use while loading cities.
# prod  -> "public, max-age=CACHE_MAX_AGE" so Cloudflare caches results + absorbs the burst.
CACHE_MODE=setup
CACHE_MAX_AGE=3600

# --- Web / HTTPS (Caddy) ----------------------------------------------------
# [PROD] Your domain (A record -> VPS IP, proxied through Cloudflare). Caddy gets
# the TLS cert automatically. Set Cloudflare SSL/TLS mode to "Full (strict)".
DOMAIN=results.example.com

# --- Telegram bot -----------------------------------------------------------
# Token from @BotFather. Leave EMPTY to disable the bot (it exits cleanly).
TELEGRAM_TOKEN=

# Comma-separated Telegram user ids allowed to ingest .zip uploads via the bot.
ADMIN_IDS=

# --- API admin --------------------------------------------------------------
# Bearer token required by POST /api/ingest. [PROD] CHANGE THIS.
ADMIN_TOKEN=changeme
